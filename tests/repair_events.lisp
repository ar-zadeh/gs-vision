;;; Loaded by test_module_events.lisp: focused repair regressions.

(format t "~%== validation repairs ==~%")
(new-test-model)
(let ((v (get-module :vision)))
  (set-parameter-value :gs-qt-init 1.7)
  (check "new initialization reaches adaptive state" (close-to (quit-threshold v) 1.7 .00001))
  (setf (feedback-log v) '(tn) (quit-threshold v) 2.0)
  (set-parameter-value :gs-qt-init 1.2)
  (check "parameter application preserves learned state" (= (quit-threshold v) 2.0))
  (setf (search-active v) t (fix-start v) (mp-time-ms) (fixation-log v) nil)
  (gs-set-eye v 512 384)
  (run-full-time .1)
  (gs-close-fixation v)
  (gs-set-eye v 600 400)
  (setf (fix-start v) (mp-time-ms))
  (run-full-time .2)
  (gs-close-fixation v)
  (gs-close-fixation v)
  (let ((log (reverse (fixation-log v))))
    (check "two occupied positions have exactly two closures" (= 2 (length log)))
    (check "initial central fixation coordinates" (equal (subseq (first log) 1 3) '(512 384)))
    (check "second fixation coordinates" (equal (subseq (second log) 1 3) '(600 400)))
    (check "first stationary duration is 100 ms" (= 100 (fourth (first log))))
    (check "final stationary duration is 200 ms" (= 200 (fourth (second log)))))
  (gs-reset-search-command)
  (gs-benchmark-gaze-command 512 384)
  (check "benchmark recenters after an off-center end" (= 512 (aref (eye-xyz v) 0)))
  (check "recentering preserves threshold and feedback" (and (= 2 (quit-threshold v)) (equal '(tn) (feedback-log v)))))

(new-test-model)
(let ((v (get-module :vision)))
  (setf (template v) '(color red))
  (add-visicon-features (feat 0 0 'red 0 0 'bar))
  (run .05)
  (gs-benchmark-gaze-command 512 384)
  (gs-start-search v '(color red) nil 'both nil)
  (let ((request (search-start v)))
    (run 2)
    (let* ((events (reverse (event-log v)))
           (first-select (find "select" events :key #'second :test #'equal))
           (identified (find "identified" events :key #'second :test #'equal))
           (buffer (find "buffer" events :key #'second :test #'equal)))
      (check "first interval is an explicit 50 ms selection cost" (= 50 (- (first first-select) request)))
      (check "identified target has no second encoding delay" (= (first identified) (first buffer)))
      (check "buffer result time defines search duration" (= (search-elapsed v) (- (first buffer) request)))
      (check "central hit includes one final fixation" (= 1 (length (fixation-log v)))))))

;;; Force recognition completion while delaying delivery; remove or reset before it.
(dolist (action '(vanish reset))
  (new-test-model)
  (let ((v (get-module :vision)))
    (add-visicon-features (feat 0 0 'red 0 0 'bar))
    (run .05)
    (gs-benchmark-gaze-command 512 384)
    (gs-start-search v '(color red) nil 'both nil)
    (setf (recognition-extra v) t)
    (let ((icon (gethash (first (icon-order v)) (iconic v))))
      (gs-finish-hit v icon)
      (if (eq action 'reset) (gs-reset-search-command) (delete-all-visicon-features))
      (run 1)
      (check (format nil "~a before delivery leaves no stale visual chunk" action)
             (null (buffer-read 'visual)))
      (check (format nil "~a cancels/completes the owned delivery event" action)
             (null (delivery-event v)))
      (when (eq action 'vanish)
        (check "vanished target records failure" (eq (search-result v) 'failed))))))

(new-test-model)
(let* ((v (get-module :vision))
       (a (make-gs-icon :entry 'a :guidance 1.0 :priority 20.0))
       (b (make-gs-icon :entry 'b :guidance 1.0 :priority -20.0)))
  (setf (choice-beta v) 16.0)
  (check "quit weights ignore noise winners at high beta"
         (every (lambda (w) (close-to w 1.0 .00001)) (gs-quit-weights v (list a b))))
  (setf (icon-order v) '(a b) (gethash 'a (iconic v)) a (gethash 'b (iconic v)) b
        (diffuser v) (list (make-gs-diff :entry 'a) (make-gs-diff :entry 'b))
        (search-active v) t (search-stop v) 'both (quit-weight v) 0.0
        (rejections v) 1 (search-qt v) 1)
  (gs-check-quit v)
  (check "threshold drains outstanding identifications before quitting" (search-active v))
  (gs-cancel-events v))
